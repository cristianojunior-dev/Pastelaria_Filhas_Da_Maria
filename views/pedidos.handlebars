<div class="pedidos-container">

    <!-- Filtro por Período em largura total no topo -->
    <div class="filtro-pedidos-row">
        <form action="/pedidos" method="GET" class="filtro-pedidos-form">
            <div class="input-group">
                <label for="data_inicio">De:</label>
                <input type="date" id="data_inicio" name="data_inicio" value="{{filtros.data_inicio}}">
            </div>
            <div class="input-group">
                <label for="data_fim">Até:</label>
                <input type="date" id="data_fim" name="data_fim" value="{{filtros.data_fim}}">
            </div>
            <button type="submit" class="btn-filtrar">Filtrar</button>
            <a href="/pedidos" class="btn-limpar">Limpar</a>
        </form>
    </div>

    <h1>Meus Pedidos</h1>

    {{#if pedidos.length}}
        <!-- ITERAÇÃO DOS PEDIDOS -->
        {{#each pedidos}}
            
            <!-- SE FOR O PRIMEIRO ITEM (O mais recente): Renderiza isolado com estilo Full Width -->
            {{#if @first}}
                <div class="pedido-card card-mais-recente">
                    <div class="pedido-header">
                        <div class="badge-recente">Pedido Mais Recente</div>
                        <h3>Pedido #{{id}}</h3>
                        <p>Status: <strong>{{status}}</strong></p>
                        <p>Data: {{data}}</p>
                        <p>Endereço: {{endereco}}</p>
                    </div>

                    <div class="pedido-itens" id="lista-itens-{{id}}">
                        {{#each itens}}
                            <div class="pedido-item {{#if (gt @index 2)}}item-oculto{{/if}}" {{#if (gt @index 2)}}style="display: none;"{{/if}}>
                                <img src="/images/{{imagem}}" alt="{{nome}}">
                                <div>
                                    <h4>{{nome}}</h4>
                                    <p>Quantidade: {{quantidade}}</p>
                                    <p>Preço: R$ {{preco}}</p>
                                </div>
                            </div>
                        {{/each}}
                    </div>

                    {{#if (gt itens.length 3)}}
                        <div class="ver-mais-wrapper">
                            <button class="btn-ver-mais" onclick="toggleItens('{{id}}', this)">
                                <i class="fa-solid fa-chevron-down"></i> Ver mais ({{math itens.length "-" 3}} itens)
                            </button>
                        </div>
                    {{/if}}

                    <div class="pedido-total">
                        <h3>Total: R$ {{total}}</h3>
                    </div>
                </div>

                <!-- ABRE A DIV DO GRID PARA OS PRÓXIMOS ITENS SE HOUVER MAIS DE UM PEDIDO -->
                {{#if (gt ../pedidos.length 1)}}
                    <div class="pedidos-grid">
                {{/if}}

            {{else}}
                <!-- DEMAIS PEDIDOS (Mais antigos): Renderizam dentro do grid de 3 colunas -->
                <div class="pedido-card">
                    <div class="pedido-header">
                        <h3>Pedido #{{id}}</h3>
                        <p>Status: <strong>{{status}}</strong></p>
                        <p>Data: {{data}}</p>
                        <p>Endereço: {{endereco}}</p>
                    </div>

                    <div class="pedido-itens" id="lista-itens-{{id}}">
                        {{#each itens}}
                            <div class="pedido-item {{#if (gt @index 2)}}item-oculto{{/if}}" {{#if (gt @index 2)}}style="display: none;"{{/if}}>
                                <img src="/images/{{imagem}}" alt="{{nome}}">
                                <div>
                                    <h4>{{nome}}</h4>
                                    <p>Quantidade: {{quantidade}}</p>
                                    <p>Preço: R$ {{preco}}</p>
                                </div>
                            </div>
                        {{/each}}
                    </div>

                    {{#if (gt itens.length 3)}}
                        <div class="ver-mais-wrapper">
                            <button class="btn-ver-mais" onclick="toggleItens('{{id}}', this)">
                                <i class="fa-solid fa-chevron-down"></i> Ver mais ({{math itens.length "-" 3}} itens)
                            </button>
                        </div>
                    {{/if}}

                    <div class="pedido-total">
                        <h3>Total: R$ {{total}}</h3>
                    </div>
                </div>

                <!-- SE FOR O ÚLTIMO ITEM DO LOOP GERAL: Fecha a div do grid -->
                {{#if @last}}
                    </div>
                {{/if}}

            {{/if}}
        {{/each}}

    {{else}}
        <p class="sem-pedidos">Você ainda não possui pedidos cadastrados neste período.</p>
    {{/if}}

</div>

<script>
function toggleItens(pedidoId, botao) {
    const container = document.getElementById(`lista-itens-${pedidoId}`);
    const itensOcultos = container.querySelectorAll('.item-oculto');
    const estaoOcultos = itensOcultos[0].style.display === 'none';

    itensOcultos.forEach(item => {
        item.style.display = estaoOcultos ? 'flex' : 'none';
    });

    if (estaoOcultos) {
        botao.innerHTML = '<i class="fa-solid fa-chevron-up"></i> Mostrar menos';
    } else {
        botao.innerHTML = `<i class="fa-solid fa-chevron-down"></i> Ver mais (${itensOcultos.length} itens)`;
    }
}
</script>
