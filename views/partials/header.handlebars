<header class="main-header">
    <div class="header-container">
        <!-- Logo Esquerda -->
        <div class="logo-area">
            <a href="/">
                <img src="/images/LOGO.transparente.png" alt="Pastelaria Filhas da Maria" class="header-logo">
            </a>
        </div>

        <!-- Barra de Pesquisa Central -->
        <div class="search-area">
            <form action="/products/search" method="GET" class="search-form">
                <div class="search-input-wrapper">
                    <input type="text" name="q" placeholder="O que você procura hoje?" class="search-input">
                    <button type="submit" class="search-btn">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </form>
        </div>

        <!-- Menu de Ícones Direita -->
        <nav class="header-nav">
            {{#if usuarioLogado}}
                <!-- Dropdown da Conta do Usuário -->
                <div class="nav-dropdown-wrapper">
                    <button class="nav-dropdown-toggle" title="Minha Conta">
                        <i class="fa-solid fa-user"></i>
                        <span>Olá, {{usuarioNome}} <i class="fa-solid fa-caret-down dropdown-arrow"></i></span>
                    </button>
                    
                    <ul class="nav-dropdown-menu">
                        {{#if userAdmin}}
                            <li>
                                <a href="/admin/dashboard" class="dropdown-link-item">
                                    <i class="fa-solid fa-user-gear"></i> Painel Admin
                                </a>
                            </li>
                            <li class="dropdown-divider"></li>
                        {{/if}}
                        
                        <li>
                            <a href="/pedidos" class="dropdown-link-item">
                                <i class="fa-solid fa-clock-rotate-left"></i> Meus Pedidos
                            </a>
                        </li>
                        
                        <li class="dropdown-divider"></li>
                        <li>
                            <a href="/auth/logout" class="dropdown-link-item logout-accent">
                                <i class="fa-solid fa-right-from-bracket"></i> Sair
                            </a>
                        </li>
                    </ul>
                </div>
            {{else}}
                <!-- Botão de Login quando não autenticado -->
                <a href="/auth/login" class="nav-link-item">
                    <i class="fa-solid fa-user-plus"></i>
                    <span>Login</span>
                </a>
            {{/if}}

            <a href="/favorites" class="nav-link-item">
                <i class="fa-regular fa-heart"></i>
                <span>Favoritos</span>
            </a>

            <a href="/cart" class="nav-link-item">
                <i class="fa-solid fa-cart-shopping"></i>
                <span>Carrinho</span>
            </a>
        </nav>
    </div>
</header>
