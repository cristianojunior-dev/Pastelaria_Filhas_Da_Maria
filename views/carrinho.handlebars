<main class="carrinho-page-container">
    <h2 class="carrinho-main-title">SEU CARRINHO</h2>

    <div class="carrinho-layout-grid">
        <!-- Lado Esquerdo: Lista de Produtos no Carrinho -->
        <section class="carrinho-itens-section">
            {{#if itens}}
                {{#each itens}}
                    <div class="card-item-carrinho" data-id="{{this.id}}">
                        <div class="item-img-box">
                            <img src="/images/{{this.imagem}}" alt="{{this.nome}}">
                        </div>
                        <div class="item-details-box">
                            <div class="item-header-row">
                                <h3 class="item-title-name">{{this.nome}}</h3>
                                <span class="item-price-tag">R$dece {{this.preco}}</span>
                            </div>
                            <p class="item-ingredients-text">{{this.descricao}}</p>
                            
                            <div class="item-actions-row">
                                <div class="quantity-control-block">
                                    <form action="/cart/update/{{this.id}}?action=minus" method="POST" style="display:inline;">
                                        <button type="submit" class="btn-qty-action">-</button>
                                    </form>
                                    <input type="number" value="{{this.quantidade}}" class="input-qty-display" readonly>
                                    <form action="/cart/update/{{this.id}}?action=plus" method="POST" style="display:inline;">
                                        <button type="submit" class="btn-qty-action">+</button>
                                    </form>
                                </div>
                                <form action="/cart/remove/{{this.id}}" method="POST" style="display:inline;">
                                    <button type="submit" class="btn-remove-item">REMOVER DO CARRINHO</button>
                                </form>
                            </div>
                        </div>
                    </div>
                {{/each}}
                
                <div class="carrinho-general-actions">
                    <form action="/cart/clear" method="POST">
                        <button type="submit" class="btn-clear-all-cart">remover todos os itens do carrinho</button>
                    </form>
                </div>
            {{else}}
                <div class="carrinho-empty-state">
                    <i class="fa-solid fa-basket-shopping"></i>
                    <p>Seu carrinho está vazio no momento.</p>
                    <a href="/" class="btn-back-menu">Ver o Cardápio</a>
                </div>
            {{/if}}
        </section>

        <!-- Lado Direito: Caixa de Resumo de Valores (Figma Página 5) -->
        {{#if itens}}
        <aside class="carrinho-summary-sidebar">
            <div class="coupon-input-box">
                <input type="text" placeholder="Insira seu cupom aqui:">
            </div>

            <div class="summary-products-list">
                <h3>PRODUTO(S):</h3>
                <ul class="summary-list-items">
                    {{#each itens}}
                        <li>
                            <span class="summary-item-name">{{this.nome}} ({{this.quantidade}}x)</span>
                            <span class="summary-item-subtotal">R$ {{this.subtotal}}</span>
                        </li>
                    {{/each}}
                </ul>
            </div>

            <div class="summary-total-row">
                <span class="total-label">Total:</span>
                <span class="total-price-value">R$ {{total}}</span>
            </div>

            <div class="summary-flow-buttons">
                <a href="/checkout" class="btn-checkout-flow btn-proceed-pay">IR PARA O PAGAMENTO</a>
                <a href="/" class="btn-checkout-flow btn-continue-shopping">CONTINUAR COMPRANDO</a>
            </div>
        </aside>
        {{/if}}
    </div>
</main>