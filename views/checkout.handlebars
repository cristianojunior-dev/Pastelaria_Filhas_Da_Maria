<main class="checkout-page-container">
    <h2 class="checkout-main-title">Resumo do pedido:</h2>

    <div class="checkout-layout-grid">
        <!-- Lado Esquerdo: Resumo dos Itens e Valores -->
        <section class="checkout-summary-card">
            <div class="summary-box-items">
                {{#each itens}}
                    <p class="summary-item-line">{{this.nome}} {{this.quantidade}}X</p>
                {{/each}}
            </div>

            <div class="summary-box-values">
                <p class="value-row"><span>Total do pedido:</span> <strong>R$ {{totalPedido}}</strong></p>
                <p class="value-row"><span>Taxa de entrega:</span> <strong>R$ {{taxaEntrega}}</strong></p>
                <div class="value-row-final"><span>Total a pagar:</span> <strong>R$ {{totalGeral}}</strong></div>
            </div>
        </section>

        <!-- Lado Direito: Formulário de Entrega e Pagamento -->
        <section class="checkout-form-card">
            <form action="/checkout/finalizar" method="POST" class="main-checkout-form">
                
                {{#if temEnderecos}}
                <!-- Lista de Endereços Salvos do Usuário -->
                <div class="checkout-form-group">
                    <label class="form-label-title">Escolha o Endereço de Entrega:</label>
                    
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        {{#each enderecos}}
                        <div style="display: flex; align-items: center; justify-content: space-between; border: 2px solid var(--rosa-destaque); padding: 12px 15px; border-radius: 8px; background-color: #FFFDF9;">
                            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 13px; font-weight: 600; color: var(--texto-escuro); flex: 1;">
                                <input type="radio" name="endereco_selecionado" value="{{this.id}}" {{#if @first}}checked{{/if}} onchange="alternarNovoEndereco(this.value)" style="width: 18px; height: 18px; accent-color: var(--laranja-principal);">
                                <span>
                                    {{this.rua}}, Nº {{this.numero}} - {{this.bairro}}<br>
                                    <small style="color: var(--texto-mutado);">{{this.cidade}}/{{this.uf}} - CEP: {{this.cep}}</small>
                                </span>
                            </label>

                            <button type="button" formaction="/checkout/endereco/remover/{{this.id}}" formnovalidate onclick="return confirm('Deseja remover este endereço da sua conta?')" style="background: #F8D7DA; color: #721C24; border: 1px solid #F5C6CB; padding: 6px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; cursor: pointer;">
                                <i class="fa-solid fa-trash"></i> Remover
                            </button>
                        </div>
                        {{/each}}

                        <!-- Opção para abrir o formulário e cadastrar um novo endereço -->
                        <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 13px; font-weight: 700; color: var(--laranja-principal); padding: 10px 5px;">
                            <input type="radio" name="endereco_selecionado" value="novo" onchange="alternarNovoEndereco(this.value)" style="width: 18px; height: 18px; accent-color: var(--laranja-principal);">
                            <span>+ Cadastrar e usar um novo endereço</span>
                        </label>
                    </div>
                </div>
                {{else}}
                    <input type="hidden" name="endereco_selecionado" value="novo">
                {{/if}}

                <!-- Bloco de Novo Endereço (ViaCEP) -->
                <div id="bloco_novo_endereco" style="display: {{#if temEnderecos}}none{{else}}flex{{/if}}; flex-direction: column; gap: 18px; border-top: 1px solid var(--rosa-fundo); padding-top: 15px;">
                    <div class="checkout-form-group">
                        <label for="cep" class="form-label-title">CEP:</label>
                        <input type="text" name="cep" id="cep" class="input-novo-endereco" placeholder="Exemplo: 13880-000" maxlength="9" {{#unless temEnderecos}}required{{/unless}}>
                        <a href="https://buscacepinter.correios.com.br/" target="_blank" class="cep-help-link">não sei meu cep</a>
                    </div>

                    <div class="checkout-form-group">
                        <label for="rua" class="form-label-title">Rua / Logradouro:</label>
                        <input type="text" name="rua" id="rua" class="input-novo-endereco" placeholder="Rua..." {{#unless temEnderecos}}required{{/unless}}>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 15px;">
                        <div class="checkout-form-group">
                            <label for="numero" class="form-label-title">Número:</label>
                            <input type="text" name="numero" id="numero" class="input-novo-endereco" placeholder="Nº 123" {{#unless temEnderecos}}required{{/unless}}>
                        </div>

                        <div class="checkout-form-group">
                            <label for="bairro" class="form-label-title">Bairro:</label>
                            <input type="text" name="bairro" id="bairro" class="input-novo-endereco" placeholder="Bairro..." {{#unless temEnderecos}}required{{/unless}}>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 15px;">
                        <div class="checkout-form-group">
                            <label for="cidade" class="form-label-title">Cidade:</label>
                            <input type="text" name="cidade" id="cidade" class="input-novo-endereco" placeholder="Cidade..." readonly {{#unless temEnderecos}}required{{/unless}}>
                        </div>

                        <div class="checkout-form-group">
                            <label for="uf" class="form-label-title">Estado (UF):</label>
                            <input type="text" name="uf" id="uf" class="input-novo-endereco" placeholder="UF" maxlength="2" readonly {{#unless temEnderecos}}required{{/unless}}>
                        </div>
                    </div>
                </div>

                <!-- Bloco Seleção de Pagamento -->
                <div class="checkout-form-group">
                    <label for="forma_pagamento" class="form-label-title">Formas de Pagamento:</label>
                    <div class="select-wrapper">
                        <select name="forma_pagamento" id="forma_pagamento" required onchange="verificarDinheiro(this.value)">
                            <option value="" disabled selected>Selecione como deseja pagar na entrega...</option>
                            <option value="PIX">PIX (na entrega)</option>
                            <option value="Dinheiro">Dinheiro (na entrega)</option>
                            <option value="Cartão de Crédito">Cartão de Crédito (na entrega)</option>
                            <option value="Cartão de Débito">Cartão de Débito (na entrega)</option>
                        </select>
                    </div>
                </div>

                <!-- Campo Dinâmico de Troco -->
                <div class="checkout-form-group id-troco-box" id="troco_container" style="display: none;">
                    <label for="troco" class="form-label-title">Troco para quanto?</label>
                    <input type="text" name="troco" id="troco" placeholder="Exemplo: Troco para R$ 50,00">
                </div>

                <div class="checkout-info-payment-notice">
                    <i class="fa-solid fa-truck-delivery"></i>
                    <p>O pagamento será realizado de forma segura diretamente ao entregador no ato da entrega.</p>
                </div>

                <button type="submit" class="btn-finalize-order">FINALIZAR PEDIDO</button>
            </form>
        </section>
    </div>
</main>

<!-- jQuery + Script de Controle de Endereços e ViaCEP -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
    function verificarDinheiro(valor) {
        const trocoBox = document.getElementById('troco_container');
        if (valor === 'Dinheiro') {
            trocoBox.style.display = 'flex';
        } else {
            trocoBox.style.display = 'none';
            document.getElementById('troco').value = '';
        }
    }

    function alternarNovoEndereco(valor) {
        const blocoNovo = document.getElementById('bloco_novo_endereco');
        const inputsNovo = document.querySelectorAll('.input-novo-endereco');

        if (valor === 'novo') {
            blocoNovo.style.display = 'flex';
            inputsNovo.forEach(input => input.setAttribute('required', 'required'));
        } else {
            blocoNovo.style.display = 'none';
            inputsNovo.forEach(input => input.removeAttribute('required'));
        }
    }

    $(document).ready(function () {
        function limpa_formulario_cep() {
            $("#rua").val("");
            $("#bairro").val("");
            $("#cidade").val("");
            $("#uf").val("");
        }

        $("#cep").blur(function () {
            var cep = $(this).val().replace(/\D/g, '');

            if (cep !== "") {
                var validacep = /^[0-9]{8}$/;

                if (validacep.test(cep)) {
                    $("#rua").val("...");
                    $("#bairro").val("...");
                    $("#cidade").val("...");
                    $("#uf").val("...");

                    $.getJSON("https://viacep.com.br/ws/" + cep + "/json/?callback=?", function (dados) {
                        if (!("erro" in dados)) {
                            $("#rua").val(dados.logradouro);
                            $("#bairro").val(dados.bairro);
                            $("#cidade").val(dados.localidade);
                            $("#uf").val(dados.uf);
                            $("#numero").focus();
                        } else {
                            limpa_formulario_cep();
                            alert("CEP não encontrado.");
                        }
                    });
                } else {
                    limpa_formulario_cep();
                    alert("Formato de CEP inválido.");
                }
            } else {
                limpa_formulario_cep();
            }
        });
    });
</script>